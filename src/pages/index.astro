---
import Advisor from '../components/Advisor';
import Calculator from '../components/Calculator';
import { advisor, prices, presets, relatedPosts } from '../lib/data';
import { CALC_KEYS } from '../lib/url';
import '../styles/global.css';

const BLOG_URL = 'https://hgko-dev.tistory.com/';
const title = 'AI 코딩 요금제 계산기 — Claude Pro·Max, ChatGPT, Gemini 뭐가 맞을까';
const description =
  '하루 몇 시간, 어떻게 쓰는지만 고르면 Claude Pro·Max 5x·Max 20x 등 AI 코딩 구독 요금제 중 나에게 맞는 것을 추천합니다. 같은 양을 API로 쓰면 얼마인지 원화로 비교.';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(base, Astro.site).toString();
const updated = prices.updatedAt;
const updatedLabel = updated.replace(/^(\d{4})-(\d{2})-(\d{2})$/, '$1년 $2월 $3일').replace(/ 0/g, ' ');
const vendorName = (id: string) => prices.vendors.find((v) => v.id === id)?.name ?? id;
const withUtm = (url: string) => {
  const u = new URL(url);
  u.searchParams.set('utm_source', 'ai-cost-calc');
  u.searchParams.set('utm_medium', 'referral');
  return u.toString();
};

const faqs = [
  {
    q: '구독과 API는 뭐가 다른가요?',
    a: '구독(Pro, Max 등)은 매달 정해진 금액을 내고 사용 한도 안에서 쓰는 방식입니다. VS Code나 터미널에서 계정으로 로그인해 쓰면 구독입니다. API는 발급받은 API 키로 연결해, 쓴 토큰 양만큼 나중에 청구되는 종량제 방식으로 주로 회사나 서비스를 만드는 개발자가 씁니다.',
  },
  {
    q: 'Claude Max 5x면 하루 몇 시간까지 쓸 수 있나요?',
    a: '운영자 경험으로는 에이전트에게 맡기는 방식으로 하루 5~6시간 쓰면 5시간 단위 한도에 자주, 주간 한도에 가끔 걸립니다. 직접 보면서 같이 코딩하는 방식이면 그보다 훨씬 오래 쓸 수 있습니다.',
  },
  {
    q: '"같은 양을 API로 냈다면"은 왜 보여주나요?',
    a: '구독이 실제로 얼마나 이득인지 감을 잡기 위해서입니다. 운영자의 실제 사용량은 Opus 5.5 API 기준 월 약 $490(약 68만 원)어치였지만, 실제로 낸 돈은 Max 5x 월 $100이었습니다.',
  },
  {
    q: '추천 결과는 정확한가요?',
    a: '추정치입니다. Anthropic·OpenAI·Google 모두 구독 한도를 정확한 숫자로 공개하지 않습니다. 이 계산기는 공식 배수(예: Max 20x = Pro의 20배)와 운영자 실사용 경험으로 기준을 잡았고, 지금 요금제에서 한도에 걸리는 빈도를 알려 주면 그 경험을 우선 반영합니다.',
  },
  {
    q: '내 실제 토큰 사용량은 어떻게 확인하나요?',
    a: 'Claude Code는 내 컴퓨터의 ~/.claude/projects 폴더에 사용량을 기록합니다. 터미널에서 npx ccusage를 실행하면 날짜별 토큰 사용량을 볼 수 있고, 이 값을 아래 "모델별 API 비용 직접 계산"에 넣으면 더 정확하게 계산됩니다.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'AI 코딩 요금제 계산기',
    url: canonical,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    inLanguage: 'ko',
    dateModified: updated,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#f7f5f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16171a" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <script is:inline>
      // ?embed=1 이면 계산기만 보이게 (티스토리 iframe 삽입용)
      if (new URLSearchParams(location.search).get('embed') === '1') document.documentElement.dataset.embed = '1';
    </script>
    <script is:inline define:vars={{ calcKeys: CALC_KEYS }}>
      // 토큰 계산기 파라미터가 있는 공유 링크로 들어오면 "자세히" 영역을 펼친다
      document.addEventListener('DOMContentLoaded', () => {
        const q = new URLSearchParams(location.search);
        if (calcKeys.some((k) => k !== 'fx' && k !== 'vat' && q.has(k))) document.getElementById('detail')?.setAttribute('open', '');
      });
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="page">
      <header class="hero">
        <p class="eyebrow">
          가격 기준 <time datetime={updated}>{updatedLabel}</time>
        </p>
        <h1>내 사용량이면 어떤 AI 코딩 요금제가 맞을까?</h1>
        <p class="lead no-embed">
          하루 몇 시간, 어떻게 쓰는지만 고르면 Pro·Max 5x·Max 20x 중 맞는 요금제를 추천합니다. 같은 양을 쓴 만큼(API) 냈다면 얼마인지도 함께 보여 드려요.
        </p>
        <a class="embed-only open-full" href={base} target="_blank" rel="noopener">전체 화면에서 자세히 보기 ↗</a>
      </header>

      <main>
        <Advisor client:load advisor={advisor} models={prices.models} plans={prices.plans} />

        <details class="detail-calc" id="detail">
          <summary>
            <strong>자세히: 모델별 API 비용 직접 계산</strong>
            <span>토큰 사용량을 알고 있는 개발자·회사 담당자용</span>
          </summary>
          <Calculator client:idle data={{ vendors: prices.vendors, models: prices.models, plans: prices.plans, presets }} />
        </details>

        <section class="prose no-embed" aria-labelledby="terms">
          <h2 id="terms">구독 vs API, 뭐가 다른가요?</h2>
          <ul>
            <li><strong>구독</strong>: 매달 정해진 금액(Pro $20, Max $100~200). 사용 한도 안에서 무제한처럼 씁니다. VS Code·터미널에서 계정으로 로그인해 쓰면 이 방식입니다.</li>
            <li><strong>API 종량제</strong>: API 키로 연결해 쓴 토큰 양만큼 청구됩니다. 한도는 없지만 많이 쓰면 요금이 크게 늘어납니다. 주로 회사나 서비스를 만드는 개발자가 씁니다.</li>
            <li><strong>결론</strong>: 매일 몇 시간씩 코딩한다면 대부분 구독이 훨씬 쌉니다. 가끔 질문하는 정도라면 API가 더 쌀 수 있습니다.</li>
          </ul>
        </section>

        <section class="prose no-embed" aria-labelledby="how">
          <h2 id="how">추천 기준</h2>
          <ol>
            <li>
              <strong>사용량 환산</strong>: 하루 사용 시간 × 사용 방식 계수(에이전트에게 맡김 1, 같이 코딩 0.5, 질문 위주 0.2)로 "에이전트 작업 환산 시간"을 구합니다. 방식 계수는 추정값입니다.
            </li>
            <li>
              <strong>요금제 한도</strong>: Claude Code 기준 Max 5x는 에이전트 작업 하루 약 6시간이 한계입니다(운영자 실사용: 5~6시간 사용 시 5시간 한도에 자주 도달). Pro는 그 1/5, Max 20x는 4배로 공식 배수를 따라 환산했습니다.
            </li>
            <li>
              <strong>상태 표시</strong>: 한도의 70% 이하면 "여유", 100% 이하면 "빠듯함", 넘으면 "부족"입니다. 지금 요금제는 계산값 대신 알려 주신 "한도에 걸리는 빈도"로 판단합니다. 자주·매일 걸리면 한 단계 위를, 거의 안 걸리면 한 단계 아래를 추천합니다.
            </li>
            <li>
              <strong>API 환산 비용</strong>: 에이전트 작업 1시간 ≈ 입력 5M·출력 16K 토큰(운영자 Claude Code 로그 82일 실측: 입력의 93%가 캐시 읽기)으로 계산하고, 각 모델의 공식 단가와 프롬프트 캐싱 할인을 반영합니다.
            </li>
            <li>
              <strong>Codex·Gemini</strong>: 실사용 데이터가 없어 같은 가격대의 Claude 요금제와 같은 수준으로 가정한 참고값입니다.
            </li>
          </ol>
        </section>

        <section class="prose no-embed" aria-labelledby="data">
          <h2 id="data">가격 데이터 <span class="muted">(확인일 {updatedLabel})</span></h2>
          <div class="table-wrap">
            <table class="detail">
              <caption>API 단가 (USD / 100만 토큰)</caption>
              <thead>
                <tr>
                  <th scope="col">모델</th>
                  <th scope="col" class="num">입력</th>
                  <th scope="col" class="num">캐시 쓰기</th>
                  <th scope="col" class="num">캐시 읽기</th>
                  <th scope="col" class="num">출력</th>
                  <th scope="col">비고</th>
                </tr>
              </thead>
              <tbody>
                {
                  prices.models.map((m) => (
                    <tr>
                      <th scope="row">
                        <a href={m.sourceUrl} rel="noopener" target="_blank">{m.name}</a>
                        <span class="sub">{vendorName(m.vendor)} · 최대 {m.contextWindowK}K</span>
                      </th>
                      <td class="num">${m.prices.input}</td>
                      <td class="num">${m.prices.cacheWrite}</td>
                      <td class="num">${m.prices.cacheRead}</td>
                      <td class="num">${m.prices.output}</td>
                      <td class="note">
                        {m.longContext && `${m.longContext.thresholdK}K 초과 시 입력 $${m.longContext.prices.input} / 출력 $${m.longContext.prices.output}. `}
                        {m.note}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <div class="table-wrap">
            <table class="detail">
              <caption>구독 요금제</caption>
              <thead>
                <tr>
                  <th scope="col">요금제</th>
                  <th scope="col" class="num">월 요금</th>
                  <th scope="col">코딩 도구</th>
                  <th scope="col">공식 한도</th>
                  <th scope="col">계산기 한도 가정 (API 환산)</th>
                </tr>
              </thead>
              <tbody>
                {
                  prices.plans.map((p) => (
                    <tr>
                      <th scope="row">
                        <a href={p.sourceUrl} rel="noopener" target="_blank">{p.name}</a>
                      </th>
                      <td class="num">
                        ${p.usdMonthly}
                        {p.krwMonthly && <span class="sub">₩{p.krwMonthly.toLocaleString('ko-KR')}</span>}
                      </td>
                      <td>{p.codingTools}</td>
                      <td class="note">{p.limitsNote}</td>
                      <td class="note">
                        월 ${p.capacityUsd.toLocaleString('en-US')}
                        <span class="sub">{p.capacityBasis}</span>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="muted small">
            출처:{' '}
            {
              prices.vendors.map((v, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={v.apiPricingUrl} rel="noopener" target="_blank">{v.name} API</a>,{' '}
                  <a href={v.planPricingUrl} rel="noopener" target="_blank">{v.name} 구독</a>
                </>
              ))
            }
            . Gemini CLI·Code Assist의 개인 구독 사용은 2026-06-18부로 종료되어 Antigravity로 이전되었습니다.
          </p>
        </section>

        <section class="prose no-embed" aria-labelledby="faq">
          <h2 id="faq">자주 묻는 질문</h2>
          {
            faqs.map((f) => (
              <details class="faq">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </section>

        <section class="prose no-embed" aria-labelledby="related">
          <h2 id="related">블로그 관련 글</h2>
          <ul class="related">
            {
              relatedPosts.map((p) => (
                <li>
                  <a href={withUtm(p.url)} target="_blank" rel="noopener">
                    <strong>{p.title}</strong>
                    <span>{p.description}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </main>

      <footer class="footer no-embed">
        <p>
          만든 사람: <a href={withUtm(BLOG_URL)} target="_blank" rel="noopener">hgko-dev 블로그</a> · Claude Code·AI 코딩 실전 기록
        </p>
        <p class="muted small">
          모든 결과는 추정치이며 실제 청구액과 다를 수 있습니다. 가격은 각 회사 공식 페이지 기준({updatedLabel} 확인)이며, 이후 변경될 수 있습니다.
        </p>
      </footer>
    </div>
  </body>
</html>
