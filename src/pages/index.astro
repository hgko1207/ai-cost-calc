---
import Changelog from '../components/Changelog.astro';
import Base from '../layouts/Base.astro';
import { prices, relatedPosts, team } from '../lib/data';
import { CALC_KEYS } from '../lib/url';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const title = 'AI 코딩 요금제 계산기 — Claude·ChatGPT·Gemini 요금제 추천과 가격 비교';
const description =
  '개인은 하루 사용 시간만 고르면 Claude Pro·Max 5x·Max 20x 중 맞는 요금제를, 회사는 인원에 맞는 도입 비용을 원화로 계산합니다. 3사 요금제와 모델 가격, 변경 기록을 한곳에서.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'AI 코딩 요금제 계산기',
    url: new URL(base, Astro.site).toString(),
    inLanguage: 'ko',
    description,
  },
];

// 예전 한 페이지 시절의 공유·삽입 링크(?tab=team, ?h=5, ?embed=1 …)를 새 페이지로 옮긴다
const PERSONAL_KEYS = ['t', 'h', 'u', 'c', 'f', 'wd', ...CALC_KEYS];
const TEAM_KEYS = ['tt', 'b', 'twd', 'hc', 'nc', 'hh', 'nh', 'lc', 'lh'];

// 가격 보드: 회사별 대표 모델(최상위·주력)만
const boardIds = ['fable-5-1', 'opus-5-5', 'sonnet-5-5', 'gpt-6-astra', 'gpt-6-1-sol', 'gemini-3-1-pro', 'gemini-3-8-flash'];
const board = boardIds.map((id) => prices.models.find((m) => m.id === id)!).filter(Boolean);
const vendorName = (id: string) => prices.vendors.find((v) => v.id === id)?.name ?? id;
const fmtDate = (d: string) => d.replace(/^(\d{4})-0?(\d+)-0?(\d+)$/, '$1.$2.$3');
const usd = (n: number) => `$${n}`;
const seatCount = team.tools.flatMap((t) => t.options).filter((o) => o.kind !== 'individual').length;
const withUtm = (url: string) => {
  const u = new URL(url);
  u.searchParams.set('utm_source', 'ai-cost-calc');
  u.searchParams.set('utm_medium', 'referral');
  return u.toString();
};
---

<Base title={title} description={description} path="" active="home" jsonLd={jsonLd}>
  <script is:inline slot="head" define:vars={{ base, personalKeys: PERSONAL_KEYS, teamKeys: TEAM_KEYS }}>
    (() => {
      const q = new URLSearchParams(location.search);
      if (![...q.keys()].length) return;
      const isTeam = q.get('tab') === 'team' || teamKeys.some((k) => q.has(k));
      const isPersonal = q.has('embed') || personalKeys.some((k) => q.has(k));
      if (!isTeam && !isPersonal) return;
      q.delete('tab');
      const qs = q.toString();
      location.replace(base + (isTeam ? 'team/' : 'personal/') + (qs ? '?' + qs : '') + location.hash);
    })();
  </script>

  <section class="home-hero">
    <div class="home-hero-text">
      <h1>AI 코딩, 어떤 요금제가<br />나한테 맞을까?</h1>
      <p class="lead">Claude·ChatGPT·Gemini 요금제와 모델 가격을 한곳에서. 공식 가격을 다시 확인해 변경 기록으로 남깁니다.</p>
      <dl class="home-stats">
        <div><dt>추적 중인 모델</dt><dd>{prices.models.length}개</dd></div>
        <div><dt>개인·팀 요금제</dt><dd>{prices.plans.length + seatCount}개</dd></div>
        <div><dt>마지막 가격 확인</dt><dd>{fmtDate(prices.updatedAt)}</dd></div>
      </dl>
    </div>
    <div class="home-entries">
      <a class="card entry" href={`${base}personal/`} data-goatcounter-click="홈: 1분 계산하기">
        <span class="entry-kicker">개인</span>
        <strong>내 요금제 추천</strong>
        <span class="muted">하루 사용 시간과 방식만 고르면 Pro·Max 중 맞는 요금제와 API 대비 절약액을 알려 드려요.</span>
        <span class="entry-go">1분 계산하기 →</span>
      </a>
      <a class="card entry" href={`${base}team/`} data-goatcounter-click="홈: 견적 내기">
        <span class="entry-kicker">팀·회사</span>
        <strong>도입 비용 견적</strong>
        <span class="muted">인원과 사용 정도로 Claude Team·ChatGPT Business 등 월·연 예산과 관리 기능을 비교해요.</span>
        <span class="entry-go">견적 내기 →</span>
      </a>
    </div>
  </section>

  <section class="home-grid">
    <div>
      <div class="sec-head">
        <h2>모델 가격 보드</h2>
        <a href={`${base}prices/#api`}>전체 가격표 →</a>
      </div>
      <div class="card board">
        <table>
          <caption class="sr-only">대표 모델 API 단가 (USD / 100만 토큰)</caption>
          <thead>
            <tr><th scope="col">모델</th><th scope="col" class="num">입력</th><th scope="col" class="num">출력</th><th scope="col" class="num">캐시 읽기</th><th scope="col">메모</th></tr>
          </thead>
          <tbody>
            {
              board.map((m) => (
                <tr>
                  <th scope="row">
                    <a href={m.sourceUrl} target="_blank" rel="noopener">{m.name}</a>
                    <span class="sub">{vendorName(m.vendor)}</span>
                  </th>
                  <td class="num">{usd(m.prices.input)}</td>
                  <td class="num">{usd(m.prices.output)}</td>
                  <td class="num">{usd(m.prices.cacheRead)}</td>
                  <td>
                    {m.priceChangesAt && <span class="pill warn-pill">{fmtDate(m.priceChangesAt)} 가격 변경</span>}
                    {m.longContext && <span class="pill">{m.longContext.thresholdK}K 초과 할증</span>}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="muted small board-note">USD / 100만 토큰 · 이름을 누르면 공식 가격 페이지로 이동</p>
      </div>
    </div>
    <div>
      <div class="sec-head">
        <h2>최근 변경</h2>
        <a href={`${base}prices/#changes`}>전체 기록 →</a>
      </div>
      <div class="card changes-card">
        <Changelog limit={4} />
      </div>
    </div>
  </section>

  <section class="home-posts">
    <div class="sec-head"><h2>블로그에서 더 보기</h2></div>
    <ul class="related">
      {
        relatedPosts.map((p) => (
          <li>
            <a href={withUtm(p.url)} target="_blank" rel="noopener">
              <strong>{p.title}</strong>
              <span>{p.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
