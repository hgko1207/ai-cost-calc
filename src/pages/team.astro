---
import FaqList from '../components/FaqList.astro';
import TeamCalc from '../components/TeamCalc';
import Base from '../layouts/Base.astro';
import { faqsFor } from '../lib/content';
import { advisor, prices, team } from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const title = '회사 AI 코딩 도구 도입 비용 — Claude Team·ChatGPT Business·Gemini Code Assist 비교';
const description =
  '인원과 사용 정도를 넣으면 Claude Team(기본·프리미엄 좌석), Enterprise, ChatGPT Business, Gemini Code Assist, 개인 구독 지원 중 어떤 방식이 싼지 월·연·1인당 예산과 관리 기능으로 비교합니다.';
const faqs = faqsFor('team');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '회사 AI 코딩 도구 도입 비용 계산기',
    url: new URL(`${base}team/`, Astro.site).toString(),
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    inLanguage: 'ko',
    dateModified: team.updatedAt,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base title={title} description={description} path="team/" active="team" jsonLd={jsonLd} wide>
  <header class="page-head">
    <h1>회사에 AI 코딩 도구를 도입한다면</h1>
    <p class="muted">인원과 사용 시간을 넣으면 결재에 바로 붙일 수 있는 예산표를 만들어 드려요.</p>
  </header>

  <TeamCalc client:load team={team} advisor={advisor} models={prices.models} plans={prices.plans} />

  <section class="page-links no-embed">
    <a class="link-card" href={`${base}guide/#adopt`}><strong>회사 도입 가이드</strong><span>파일럿 → 좌석 확정 → 연간 전환, 체크리스트</span></a>
    <a class="link-card" href={`${base}prices/#team`}><strong>팀·회사 요금제 가격표</strong><span>좌석 가격, 최소 인원, 관리 기능</span></a>
    <a class="link-card" href={`${base}personal/`}><strong>개인 요금제 추천</strong><span>Pro·Max 중 나에게 맞는 것</span></a>
  </section>

  <FaqList id="faq" items={faqs} moreHref={`${base}guide/`} />
</Base>
