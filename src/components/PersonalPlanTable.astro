---
// 개인 구독 요금제 표
import { planAgentHours } from '../lib/advisor';
import { advisor, prices } from '../lib/data';
import { isStale } from '../lib/priceCheck';

const buildDay = new Date().toISOString().slice(0, 10); // 빌드한 날 기준

// 에이전트에게 맡기는 방식 기준 하루 사용 가능 시간. 추정치라 ±15% 범위로 보여 준다
const rangeText = (h?: number) => {
  if (h == null) return '-';
  if (h >= 16) return '하루 종일 써도 여유';
  const lo = Math.max(0.5, Math.round(h * 0.85 * 2) / 2);
  const hi = Math.round(h * 1.15 * 2) / 2;
  return `에이전트 작업 하루 약 ${lo}~${hi}시간`;
};
---

{
  prices.vendors.map((v, idx) => (
    <details class="vendor-group" open={idx === 0}>
      <summary>
        {v.name} <span class="muted">{prices.plans.filter((p) => p.vendor === v.id).length}개 요금제</span>
      </summary>
      <div class="table-wrap" tabindex="0" role="region" aria-label={`${v.name} 요금제 표`}>
        <table class="detail">
          <thead>
            <tr>
              <th scope="col">요금제</th>
              <th scope="col" class="num">월 요금</th>
              <th scope="col">코딩 도구</th>
              <th scope="col">공식 한도</th>
              <th scope="col">하루 사용 가능 시간 (추정)</th>
            </tr>
          </thead>
          <tbody>
            {prices.plans
              .filter((p) => p.vendor === v.id)
              .map((p) => (
                <tr>
                  <th scope="row">
                    <a href={p.sourceUrl} rel="noopener" target="_blank">
                      {p.name}
                    </a>
                    {isStale(p.verifiedAt, buildDay) && <span class="pill warn-pill">확인 필요</span>}
                  </th>
                  <td class="num">
                    ${p.usdMonthly}
                    {p.krwMonthly && <span class="sub">₩{p.krwMonthly.toLocaleString('ko-KR')}</span>}
                  </td>
                  <td>{p.codingTools}</td>
                  <td class="note">{p.limitsNote}</td>
                  <td class="note">{rangeText(planAgentHours(advisor, p.id))}</td>
                </tr>
              ))}
          </tbody>
        </table>
      </div>
    </details>
  ))
}
<p class="muted small">
  하루 사용 가능 시간 추정의 근거: {advisor.tools.map((t) => t.basis).join(' ')}
</p>
<p class="muted small">
  출처:{' '}
  {
    prices.vendors.map((v, i) => (
      <>
        {i > 0 && ' · '}
        <a href={v.planPricingUrl} rel="noopener" target="_blank">{v.name} 요금제</a>
      </>
    ))
  }
  . 원화 표기가 없는 요금제는 달러 가격(부가세 별도)입니다. Gemini CLI·Code Assist의 개인 구독 사용은 2026-06-18부로 종료되어 Antigravity로 이전되었습니다.
</p>
