---
// 개인 구독 요금제 표
import { planAgentHours } from '../lib/advisor';
import { advisor, prices } from '../lib/data';

const basisOf = (planId: string) => advisor.tools.find((t) => t.plans.some((p) => p.planId === planId))?.basis;
---

<div class="table-wrap">
  <table class="detail">
    <caption>개인 구독 요금제</caption>
    <thead>
      <tr>
        <th scope="col">요금제</th>
        <th scope="col" class="num">월 요금</th>
        <th scope="col">코딩 도구</th>
        <th scope="col">공식 한도</th>
        <th scope="col">계산기의 하루 한도 추정</th>
      </tr>
    </thead>
    <tbody>
      {
        prices.plans.map((p) => (
          <tr>
            <th scope="row">
              <a href={p.sourceUrl} rel="noopener" target="_blank">{p.name}</a>
            </th>
            <td class="num">
              ${p.usdMonthly}
              {p.krwMonthly && <span class="sub">₩{p.krwMonthly.toLocaleString('ko-KR')}</span>}
            </td>
            <td>{p.codingTools}</td>
            <td class="note">{p.limitsNote}</td>
            <td class="note">
              {planAgentHours(advisor, p.id) != null ? `에이전트 작업 하루 약 ${planAgentHours(advisor, p.id)}시간` : '-'}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<p class="muted small">
  하루 한도 추정의 근거: {advisor.tools.map((t) => `${t.name} — ${t.basis}`).join(' ')}
</p>
<p class="muted small">
  출처:{' '}
  {
    prices.vendors.map((v, i) => (
      <>
        {i > 0 && ' · '}
        <a href={v.planPricingUrl} rel="noopener" target="_blank">{v.name} 요금제</a>
      </>
    ))
  }
  . 원화 표기가 없는 요금제는 달러 가격(부가세 별도)입니다. Gemini CLI·Code Assist의 개인 구독 사용은 2026-06-18부로 종료되어 Antigravity로 이전되었습니다.
</p>
